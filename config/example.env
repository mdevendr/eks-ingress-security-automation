# Copy to config/lab.env and replace every REQUIRED value.
AWS_PROFILE=default
AWS_REGION=eu-west-2
CLUSTER_NAME=secure-alb-lab
KUBERNETES_VERSION=1.34
NODE_INSTANCE_TYPES=t3.medium,t3a.medium
WEB_ACL_ARN=REQUIRED
HOSTED_ZONE_ID=REQUIRED
HOSTNAME=secure-alb.example.com
ACM_CERTIFICATE_ARN=REQUIRED
ALB_LOG_BUCKET=REQUIRED
SHIELD_ADVANCED_ENABLED=false
PUBLIC_DNS_ENABLED=false
RUN_ID=secure-alb-lab
RECONCILIATION_MODE=REMEDIATE
